# Copia este archivo como .env y cambia los valores. NO subas .env a GitHub.

# Puerto donde arranca el servidor web.
PORT=3000

# URI de PostgreSQL. Elige UNA de estas opciones y borra el # del inicio:
# 1) Docker Desktop (compose.yaml publica el puerto 55432):
DATABASE_URL=postgresql://mallmapai:cambia_esta_clave@localhost:55432/mallmapai
# 2) PostgreSQL instalado en Windows (puerto 5432 y la clave que elegiste al instalar):
# DATABASE_URL=postgresql://postgres:TU_CLAVE@localhost:5432/mallmapai
# 3) Supabase (Connect > Session pooler). Codifica caracteres especiales de la clave (@ -> %40):
# DATABASE_URL=postgresql://postgres.TU_PROYECTO:TU_CLAVE@aws-1-REGION.pooler.supabase.com:5432/postgres

# TLS hacia la base: off (local), no-verify (cifra sin validar certificado) o verify (valida con DB_SSL_CA_FILE).
DB_SSL=off
# DB_SSL_CA_FILE=C:\ruta\prod-ca-2021.crt

# Token de servicio para crear, editar, borrar e importar promociones (mínimo 16 caracteres).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=cambia-este-token-por-uno-largo

# Solo para las pruebas de integración: una base SEPARADA (se borra y se recrea en cada prueba).
# TEST_DATABASE_URL=postgresql://mallmapai:cambia_esta_clave@localhost:55432/mallmapai_test

# Clave que usa compose.yaml para crear el usuario de la base en Docker.
POSTGRES_PASSWORD=cambia_esta_clave
