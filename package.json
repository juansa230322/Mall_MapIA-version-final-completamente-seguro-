{
  "name": "mallmapai",
  "version": "1.0.0",
  "private": true,
  "description": "MallMapAI: navegación interior 2D y cálculo de rutas para Unicentro Bogotá (prototipo académico, sector piloto).",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:api": "node --env-file-if-exists=.env --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "db:seed-sql": "node scripts/generar-seed.js",
    "db:init": "node --env-file-if-exists=.env scripts/db-init.js",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1 \"tests/unit/*.test.js\" \"tests/integration/*.test.js\"",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:integration": "node --env-file-if-exists=.env --test --test-concurrency=1 \"tests/integration/*.test.js\"",
    "test:e2e": "playwright test",
    "import:promos": "python importer/importar_promociones.py"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^7.1.0"
  }
}
